btn_rull = tk.Button(root, text="Правила игры", command=show_rull, font=("Arial", 12), bg="lightgreen")
btn_rull.pack(pady=10)
btn_verify = tk.Button(root, text="Проверить расстановку", command=verification, font=("Arial", 12), bg="lightgreen")
btn_verify.pack(pady=10)

root.mainloop()
